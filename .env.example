# Copy to .env and fill in. Load with:  set -a; source .env; set +a
#
# Find ORGANIZATION_NAME / ACCOUNT_NAME in Snowsight: bottom-left account menu
# -> Account -> View account details. Do NOT use the legacy locator (e.g. ab12345).

export SNOWFLAKE_ORGANIZATION_NAME=""
export SNOWFLAKE_ACCOUNT_NAME=""
export SNOWFLAKE_USER=""
export SNOWFLAKE_ROLE="ACCOUNTADMIN"
export SNOWFLAKE_AUTHENTICATOR="SNOWFLAKE_JWT"

# Key content, not path — the provider expects the PEM itself.
# Generate the pair once:
#   openssl genrsa 2048 | openssl pkcs8 -topk8 -inform PEM -out ~/.snowflake/rsa_key.p8 -nocrypt
#   openssl rsa -in ~/.snowflake/rsa_key.p8 -pubout -out ~/.snowflake/rsa_key.pub
# Then register the PUBLIC key on the Snowflake user (see terraform/README.md).
export SNOWFLAKE_PRIVATE_KEY="$(cat ~/.snowflake/rsa_key.p8)"
